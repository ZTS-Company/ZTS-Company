---
import Button from '../components/ui/Button.astro';
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow"><i></i>Desarrollo web y software a la medida</p>
    <h1 id="hero-title">SU PRÓXIMO<br />PASO, HECHO<br /><em>SOFTWARE.</em></h1>
    <p class="tagline">Desarrollo a tu medida, éxito a tu alcance.</p>
    <p class="description">Transformamos sus ideas y procesos manuales en sitios web, aplicaciones y sistemas que le ayudan a avanzar.</p>
    <div class="actions"><Button href="#contacto">Cuéntenos su proyecto</Button><Button href="#soluciones" variant="text">Explore las soluciones ↓</Button></div>
  </div>
  <div class="visual" aria-label="Espacio reservado para el modelo 3D de la constelación">
    <p>En este apartado va el modelo 3D de la constelacion</p>
  </div>
</section>
<style>
.hero{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:48px;padding:88px var(--space-container-x) 64px;overflow:hidden}.copy{display:flex;flex-direction:column;align-items:flex-start;gap:24px}.eyebrow{display:flex;align-items:center;gap:10px;color:var(--color-text-muted);font-size:12px;font-weight:700;letter-spacing:.125em;text-transform:uppercase}.eyebrow i{width:7px;height:7px;background:var(--color-primary)}h1{font-size:clamp(42px,5vw,68px);font-weight:800;letter-spacing:-.038em;line-height:1.04}h1 em{color:var(--color-primary);font-style:normal}.tagline{font-size:21px;font-weight:600}.description{max-width:530px;color:var(--color-text-muted);font-size:18px;line-height:1.65}.actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.visual{min-height:492px;position:relative;display:grid;place-items:center;text-align:center;color:var(--color-text-muted);font-size:18px;line-height:1.5}@media(max-width:900px){.hero{grid-template-columns:1fr;padding:64px 24px}.visual{min-height:410px}}
</style>

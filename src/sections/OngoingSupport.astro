---
import { ongoingSupport, workingPrinciples } from '../data/home';

const icons = [
  '<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 8.7 4a8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.4Z"/><path d="M16 21v-2.5a2.5 2.5 0 0 0-2.5-2.5h-7A2.5 2.5 0 0 0 4 18.5V21"/>',
  '<path d="m12 3 9 4.5-9 4.5-9-4.5L12 3Z"/><path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/>',
  '<path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6"/>',
  '<path d="m8 12 2.5 2.5a2 2 0 0 0 3 0l3-3"/><path d="m2 12 5-5 4 1 3-1 8 6-5 6-3-2-2 2-3-2-2 1-5-5Z"/>',
];
---

<section class="support" id="nosotros" aria-labelledby="support-title">
  <div class="support__inner">
    <div class="support__promise">
      <p class="support__eyebrow"><span></span>{ongoingSupport.label}</p>
      <h2 id="support-title">{ongoingSupport.title}</h2>
      <p class="support__description">{ongoingSupport.description}</p>
      <ul class="support__topics">
        {ongoingSupport.topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </div>
    <ul class="support__commitments">
      {workingPrinciples.map((principle, index) => (
        <li class="commitment">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[index]} />
          <div><h3>{principle.title}</h3><p>{principle.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .support{background:#141414;color:#fefefe;padding:88px var(--space-container-x)}
  .support__inner{max-width:1280px;margin-inline:auto;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr);gap:96px;align-items:start}
  .support__eyebrow{display:flex;align-items:center;gap:10px;color:#aaa;font-size:11px;font-weight:700;letter-spacing:.12em;margin-bottom:26px}
  .support__eyebrow span{width:7px;height:7px;background:var(--color-primary);display:inline-block}
  .support h2{font-size:clamp(34px,3.3vw,48px);font-weight:900;letter-spacing:-.04em;line-height:1.1;white-space:pre-line}
  .support__description{font-size:17px;line-height:1.6;color:#aaa;margin-top:26px;max-width:550px}
  .support__topics{list-style:none;display:flex;flex-wrap:wrap;gap:10px;padding:0;margin:26px 0 0}
  .support__topics li{border:1px solid #383838;border-radius:100px;padding:7px 14px;color:#ddd;font-size:11px}
  .support__commitments{list-style:none;padding:0;margin:0}
  .commitment{display:grid;grid-template-columns:24px minmax(0,1fr);gap:24px;border-top:1px solid #333;padding:22px 0}
  .commitment svg{width:24px;height:24px;color:#f21d2b;margin-top:1px}
  .commitment h3{font-size:21px;font-weight:700;line-height:1.3;margin-bottom:7px}
  .commitment p{font-size:15px;line-height:1.6;color:#aaa}
  @media(max-width:900px){.support{padding-block:72px}.support__inner{grid-template-columns:1fr;gap:48px}.support h2 br{display:none}}
  @media(max-width:560px){.support{padding-block:56px}.commitment{gap:16px;padding:20px 0}.commitment h3{font-size:18px}}
</style>

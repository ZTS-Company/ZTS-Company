---
import { solutions } from '../data/home';

const icons: Record<string, string> = {
  store: '<path d="M3 10h18l-2-6H5l-2 6Z"/><path d="M5 10v10h14V10M9 20v-6h6v6M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/>',
  bulb: '<path d="M9 18h6m-5 3h4m-5-6a7 7 0 1 1 6 0c-.7.5-1 1.2-1 3h-4c0-1.8-.3-2.5-1-3Z"/>',
  chart: '<path d="M3 20h18M6 17v-4m4 4V9m4 8v-6m4 6V5M4 9l5-5 4 3 7-6"/>',
};
---
<section class="solutions" id="soluciones" aria-labelledby="solutions-title">
  <div class="solutions__inner">
    <header class="solutions__header">
      <div>
        <p class="solutions__eyebrow"><span></span>02 / SU PUNTO DE PARTIDA</p>
        <h2 id="solutions-title">DISTINTOS RETOS.<br />EL MISMO COMPROMISO.</h2>
      </div>
      <p class="solutions__intro">No necesita tener todas las respuestas. Empezamos por entender dónde está su negocio y qué necesita resolver.</p>
    </header>
    <div class="solutions__grid">
      {solutions.map((solution) => (
        <article class="solution-card">
          <div class="solution-card__meta">
            <p>{solution.audience}</p>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[solution.icon]} />
          </div>
          <h3>{solution.title}</h3>
          <p class="solution-card__description">{solution.description}</p>
          <a class="solution-card__link" href="#contacto"><span>{solution.offer}</span><span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .solutions{background:#000;color:#fefefe;padding:96px var(--space-container-x) 104px}
  .solutions__inner{max-width:1280px;margin-inline:auto}
  .solutions__header{display:grid;grid-template-columns:1.2fr .8fr;align-items:end;gap:64px;margin-bottom:48px}
  .solutions__eyebrow{display:flex;align-items:center;gap:10px;color:#aaa;font-size:11px;font-weight:700;letter-spacing:.12em;margin-bottom:26px}
  .solutions__eyebrow span{width:7px;height:7px;background:var(--color-primary);display:inline-block}
  .solutions h2{font-size:clamp(32px,3.3vw,48px);font-weight:900;letter-spacing:-.045em;line-height:1.08}
  .solutions__intro{font-size:17px;line-height:1.6;color:#aaa;max-width:480px;padding-bottom:2px}
  .solutions__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .solution-card{background:#141414;border-radius:4px;padding:28px;min-height:299px;display:flex;flex-direction:column}
  .solution-card__meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}
  .solution-card__meta p{font-size:10px;font-weight:700;letter-spacing:.04em;color:#aaa}
  .solution-card__meta svg{width:23px;height:23px;color:#f21d2b}
  .solution-card h3{font-size:24px;font-weight:700;line-height:1.3;white-space:pre-line;letter-spacing:-.025em;margin-bottom:24px}
  .solution-card__description{color:#aaa;font-size:15px;line-height:1.6;margin-bottom:24px}
  .solution-card__link{margin-top:auto;border-top:1px solid #333;padding-top:18px;display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:600;color:#fff}
  .solution-card__link span:last-child{font-size:20px;line-height:1;transition:transform .2s}
  .solution-card__link:hover span:last-child{transform:translateX(4px)}
  @media(max-width:900px){.solutions{padding-block:72px}.solutions__header{grid-template-columns:1fr;gap:22px}.solutions__grid{gap:16px}.solution-card{padding:22px}}
  @media(max-width:650px){.solutions{padding-block:56px}.solutions__grid{grid-template-columns:1fr}.solution-card{min-height:280px}}
</style>

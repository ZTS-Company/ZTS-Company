---
import { workingPrinciples } from '../data/home';
---
<section class="principles" aria-label="Principios de trabajo">
  {workingPrinciples.map((principle) => <article><span>{principle.number}</span><p>{principle.title}</p></article>)}
</section>
<style>
.principles{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px var(--space-container-x);border-block:1px solid var(--color-border)}article{display:flex;align-items:center;gap:12px}article span{color:var(--color-primary);font-family:var(--font-display);font-weight:700}article p{font-size:14px;font-weight:600}@media(max-width:800px){.principles{padding:24px;display:grid;grid-template-columns:1fr 1fr}}
</style>
